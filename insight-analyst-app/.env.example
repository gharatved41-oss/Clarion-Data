# Clarion Data Frontend Environment Variables (insight-analyst-app)

# Backend FastAPI API Endpoint URL (Leave blank to use Vite proxy in dev, or set to your backend URL in production)
VITE_API_URL=http://localhost:8000

# Optional: Direct Frontend integrations (if needed)
# VITE_GEMINI_API_KEY=your_gemini_api_key_here
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
